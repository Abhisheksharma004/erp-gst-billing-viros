SIZE 50 mm, 25 mm
GAP {{VGAP}} mm, 0 mm
SPEED 4
DENSITY {{DENSITY}}
DIRECTION 1
REFERENCE 0,0
SET PEEL OFF
SET CUTTER OFF
SET TEAR ON
CLS
QRCODE {{QR_X}},{{QR_Y}},M,{{QR_SIZE}},A,0,"{{QR_DATA}}"
TEXT {{TEXT_X}},{{Y_NAME}},"{{FONT_NAME}}",0,1,1,"{{PRODUCT_NAME}}"
TEXT {{TEXT_X}},{{Y_PAYLOAD}},"{{FONT_BODY}}",0,1,1,"{{PAYLOAD}}"
TEXT {{TEXT_X}},{{Y_CUSTOM1}},"{{FONT_NOTE}}",0,1,1,"{{CUSTOM_1}}"
TEXT {{TEXT_X}},{{Y_CUSTOM2}},"{{FONT_NOTE}}",0,1,1,"{{CUSTOM_2}}"
PRINT 1,1
